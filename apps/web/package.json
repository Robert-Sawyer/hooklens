{
  "name": "@hooklens/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-next-env.mjs dev && next dev --port 3000",
    "build": "node scripts/prepare-next-env.mjs build && next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "next": "16.2.11",
    "postcss": "8.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
