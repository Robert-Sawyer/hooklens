generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  pending
  delivered
  failed
}

enum RetryAuditOutcome {
  queued
  rejected
}

enum KnowledgeCategory {
  documentation
  runbook
  postmortem
}

enum KnowledgeEmbeddingStatus {
  pending
  ready
  failed
}

model WebhookEvent {
  id         String            @id @default(uuid())
  eventType  String
  payload    Json
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([eventType, createdAt])
}

model WebhookDelivery {
  id               String               @id @default(uuid())
  eventId          String
  targetUrl        String
  status           DeliveryStatus       @default(pending)
  requestHeaders   Json                 @default("{}")
  lastHttpStatus   Int?
  lastResponseBody String?
  retryCount       Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  event            WebhookEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts         DeliveryAttempt[]
  retryAudits      DeliveryRetryAudit[]

  @@index([eventId])
  @@index([status, createdAt])
}

model DeliveryAttempt {
  id            String          @id @default(uuid())
  deliveryId    String
  attemptNumber Int
  status        DeliveryStatus
  httpStatus    Int?
  responseBody  String?
  durationMs    Int?
  createdAt     DateTime        @default(now())
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, createdAt])
}

model DeliveryRetryAudit {
  id                  String            @id @default(uuid())
  deliveryId          String?
  requestedDeliveryId String
  actorRole           String
  idempotencyKey      String
  outcome             RetryAuditOutcome
  reason              String?
  attemptNumber       Int?
  retryCountAfter     Int?
  createdAt           DateTime          @default(now())
  delivery            WebhookDelivery?  @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@unique([requestedDeliveryId, idempotencyKey])
  @@index([deliveryId, createdAt])
}

model KnowledgeDocument {
  id              String                   @id
  sourcePath      String                   @unique
  title           String
  category        KnowledgeCategory
  eventTypes      String[]                 @default([])
  checksum        String
  embeddingModel  String?
  embeddingStatus KnowledgeEmbeddingStatus @default(pending)
  embeddingError  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  chunks          KnowledgeChunk[]

  @@index([category, updatedAt])
  @@index([embeddingStatus])
}

model KnowledgeChunk {
  id              String                       @id @default(uuid())
  documentId      String
  sequence        Int
  title           String
  section         String
  content         String
  eventTypes      String[]                     @default([])
  tokenEstimate   Int
  embedding       Unsupported("vector(1536)")?
  embeddingModel  String?
  embeddingStatus KnowledgeEmbeddingStatus     @default(pending)
  embeddingError  String?
  createdAt       DateTime                     @default(now())
  document        KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sequence])
  @@index([documentId, createdAt])
  @@index([embeddingStatus])
}
