{
  "name": "@hooklens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma": "node --env-file=../../.env scripts/run-prisma.mjs",
    "db:generate": "node --env-file=../../.env scripts/run-prisma.mjs generate",
    "db:migrate": "node --env-file=../../.env scripts/run-prisma.mjs migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
