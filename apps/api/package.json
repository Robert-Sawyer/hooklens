{
  "name": "@hooklens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "prisma": "node --env-file=../../.env scripts/run-prisma.mjs",
    "db:generate": "node --env-file=../../.env scripts/run-prisma.mjs generate",
    "db:migrate": "node --env-file=../../.env scripts/run-prisma.mjs migrate deploy",
    "db:seed": "node --env-file=../../.env --import tsx src/scripts/seed.ts",
    "knowledge:ingest": "node --env-file=../../.env --import tsx src/scripts/ingest-knowledge.ts",
    "eval:retrieval": "node --env-file=../../.env --import tsx src/scripts/evaluate-retrieval.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "openai": "6.0.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "4.1.0"
  }
}
