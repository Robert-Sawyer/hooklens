{
  "name": "hooklens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @hooklens/api dev",
    "web:dev": "pnpm --filter @hooklens/web dev",
    "web:start": "pnpm --filter @hooklens/web start",
    "mcp:dev": "pnpm --filter @hooklens/mcp dev",
    "mcp:start": "pnpm --filter @hooklens/mcp start",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "pnpm --filter @hooklens/api test:types && pnpm --filter @hooklens/api test",
    "test:web": "pnpm --filter @hooklens/web test:types && pnpm --filter @hooklens/web test",
    "build": "pnpm --filter @hooklens/api build && pnpm --filter @hooklens/mcp build && pnpm --filter @hooklens/web build",
    "check": "pnpm format:check && pnpm --filter @hooklens/api lint && pnpm --filter @hooklens/mcp lint && pnpm --filter @hooklens/web lint",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hooklens/api db:generate",
    "db:migrate": "pnpm --filter @hooklens/api db:migrate",
    "db:seed": "pnpm --filter @hooklens/api db:seed",
    "knowledge:ingest": "pnpm --filter @hooklens/api knowledge:ingest",
    "eval:retrieval": "pnpm --filter @hooklens/api eval:retrieval"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
