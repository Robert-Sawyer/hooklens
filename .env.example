# Database
DATABASE_URL="postgresql://hooklens:hooklens@localhost:5433/hooklens?schema=public"

# API
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Web UI
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"

# MCP (local server)
MCP_PORT=4001
# Keep false unless the local MCP client may request an auditable retry.
MCP_OPERATOR_ENABLED=false
MCP_API_URL="http://127.0.0.1:4000"

# AI embeddings
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_DIAGNOSIS_MODEL="gpt-5.6-terra"

# Keep secrets only in `.env`, never commit them.
